NODE_ENV=development
PORT=5000

# PostgreSQL. Railway обычно предоставляет DATABASE_URL автоматически.
DATABASE_URL=postgresql://user:password@localhost:5432/fitness_app

# Токен бота от BotFather. Никогда не коммитьте настоящее значение.
TELEGRAM_BOT_TOKEN=replace_me

# Случайная строка минимум 32 байта, отдельная от токена Telegram.
SESSION_SECRET=replace_with_a_long_random_secret

# Разрешённые адреса frontend через запятую.
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Публичный HTTPS URL backend для Telegram webhook.
# На Railway обычно используется RAILWAY_PUBLIC_DOMAIN автоматически.
BACKEND_URL=https://your-backend.example.com
